# Public canonical origin. Production must use HTTPS and no trailing path.
APP_ORIGIN=https://mohanagorik.example.com

# Configure these as encrypted deployment secrets. Never commit real values.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-rotated-google-client-secret
GOOGLE_SESSION_SECRET=replace-with-at-least-32-random-bytes
